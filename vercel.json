{
  "redirects": [
    {
      "source": "/:section(bio|resume|contact|design-services|fractional-cdo|portfolio|articles|art|font-test.html):rest(/.*)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(images|video|models|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
